
# ==========================================
# AI MODEL & CAMERA
# ==========================================

# Path to trained YOLO Detection model
MODEL_PATH=training/results/fall_detection_yolo11n_v1/weights/best.pt

# ESP32-CAM MJPEG stream URL
ESP32_CAMERA_URL=http://YOUR_ESP32_IP:81/stream


# ==========================================
# TELEGRAM - SHARED BOT
# ==========================================

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=YOUR_TELEGRAM_BOT_USERNAME


# ==========================================
# DATABASE - POSTGRESQL
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fall_detection_db
DB_USER=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD


# ==========================================
# JWT AUTHENTICATION
# ==========================================

JWT_SECRET_KEY=YOUR_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ==========================================
# BACKEND API
# ==========================================

BACKEND_API_URL=http://127.0.0.1:8000


# ==========================================
# CENTRAL AI SERVER
# ==========================================

CENTRAL_AI_API_URL=http://127.0.0.1:8001
CENTRAL_AI_API_KEY=YOUR_CENTRAL_AI_API_KEY
