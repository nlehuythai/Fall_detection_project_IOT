
# ==========================================
# YOLO MODEL & CAMERA
# ==========================================

# Path to trained YOLO11n model
MODEL_PATH=training/results/fall_detection_yolo11n_v1/weights/best.pt

# Camera source: 0 = Laptop webcam
WEBCAM_SOURCE=0

# ESP32-CAM MJPEG stream URL
ESP32_CAMERA_URL=http://YOUR_ESP32_IP:81/stream


# ==========================================
# TELEGRAM - LEGACY CONFIGURATION
# ==========================================

# Optional: Legacy single Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Fernet encryption key for household Telegram Bot tokens
TELEGRAM_ENCRYPTION_KEY=YOUR_FERNET_ENCRYPTION_KEY


# ==========================================
# DATABASE - POSTGRESQL
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fall_detection_db
DB_USER=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD


# ==========================================
# JWT AUTHENTICATION
# ==========================================

JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ==========================================
# BACKEND API
# ==========================================

BACKEND_API_URL=http://127.0.0.1:8000


# ==========================================
# CAMERA DEVICE AUTHENTICATION
# ==========================================

DEVICE_ID=CAMERA_01
DEVICE_API_KEY=YOUR_DEVICE_API_KEY
